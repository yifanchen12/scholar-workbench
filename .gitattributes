* text=auto
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.html text eol=lf
*.css text eol=lf
# Keep actual CRLF bytes in repository archives as well as working trees.
*.cmd -text whitespace=cr-at-eol
*.pdf binary
*.png binary
*.zip binary
*.wasm binary
*.bcmap binary
*.ttf binary
*.otf binary
*.pfb binary
